# ---- PostgreSQL ----
POSTGRES_USER=pms
POSTGRES_PASSWORD=pms_dev_password
POSTGRES_DB=chirala_pms
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Per-service DB URLs (schema-per-service on the shared cluster).
# Runtime role is NOT a superuser and does NOT have BYPASSRLS (schema §12).
IAM_DATABASE_URL=postgresql+psycopg://pms:pms_dev_password@localhost:5432/chirala_pms
BOOKING_DATABASE_URL=postgresql+psycopg://pms:pms_dev_password@localhost:5432/chirala_pms
FINANCE_DATABASE_URL=postgresql+psycopg://pms:pms_dev_password@localhost:5432/chirala_pms

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
# Rate limiting (public booking API, sign-in routes) counts per caller address
# in Redis. Only these peers' X-Forwarded-For is believed: the gateway, by its
# compose name. Leave it unless the gateway is called something else.
# TRUSTED_PROXIES=gateway
# Per address, per sign-in route (login, platform login, forgot password,
# email codes): AUTH_RATE_LIMIT requests every AUTH_RATE_LIMIT_SECONDS.
# AUTH_RATE_LIMIT=30
# AUTH_RATE_LIMIT_SECONDS=300

# ---- NATS ----
NATS_URL=nats://localhost:4222

# ---- MinIO (S3-compatible object storage) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=chirala-pms

# ---- Keycloak (OIDC) ----
OIDC_ISSUER=http://localhost:8080/realms/chirala
OIDC_AUDIENCE=chirala-pms
OIDC_JWKS_URL=http://localhost:8080/realms/chirala/protocol/openid-connect/certs

# ---- Service ports ----
IAM_PORT=8001
BOOKING_PORT=8002
FINANCE_PORT=8003
GATEWAY_PORT=8000

# ---- App ----
# `local` turns on developer conveniences: the X-Debug-Subject header,
# password-less sign-in by subject, and unsigned dev session tokens. Anything
# else (and unset, which means `production`) turns them off and makes every
# service refuse to start while SESSION_SIGNING_KEY or
# CREDENTIAL_ENCRYPTION_KEYS is empty, the MinIO keys are `minioadmin`, or a
# database URL still carries the example password below.
ENVIRONMENT=local
LOG_LEVEL=INFO

# Signs session tokens. Shared by iam (which issues them) and every service
# (which checks them). Comma-separated, newest first: the first key signs and
# all of them verify, so rotate by adding a new key in front, waiting out one
# session lifetime, then dropping the old one. At least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# May be left empty with ENVIRONMENT=local, where dev tokens are issued instead.
SESSION_SIGNING_KEY=
# How long a session lasts before signing in again (minutes). Default 12 hours.
SESSION_TTL_MINUTES=720

# ---- Mail (Google Workspace) ----
# Two ways to authenticate; pick one.
#
# A) App Password on a single Workspace account. Simplest, and what most
#    properties start with. The account must have 2-Step Verification on, then
#    Google Account > Security > App passwords generates a 16-character
#    password. Paste it here WITHOUT the spaces Google shows.
#
#      SMTP_HOST=smtp.gmail.com
#      SMTP_PORT=587
#      SMTP_USERNAME=the.full@address.com      # the whole address, not a user
#      SMTP_PASSWORD=abcdefghijklmnop          # the app password, no spaces
#
# B) Workspace SMTP relay, for sending as an address nobody signs in to
#    (noreply@, reservations@). Admin console > Apps > Google Workspace >
#    Gmail > Routing > SMTP relay service. Allow the server's public IP, or
#    tick "Require SMTP Authentication" and use an app password as in (A).
#
#      SMTP_HOST=smtp-relay.gmail.com
#      SMTP_PORT=587
#
# IMPORTANT — the From address. Gmail rewrites From to the authenticated
# account unless that account owns the address. To send as noreply@yourdomain,
# add it in Gmail > Settings > Accounts > "Send mail as" and verify it, or use
# the relay in (B). Otherwise your welcome emails arrive from whoever's
# mailbox you authenticated with.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_SENDER_NAME=Chirala Bay Resort
SMTP_STARTTLS=true

# The address staff actually use, because the link inside a welcome email is
# built from it. A link to localhost is useless in somebody's inbox.
APP_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------- payments --
# The booking engine takes money through Razorpay. Leave these blank and the
# mock provider stands in: orders get obviously-fake ids (mock_order_...) and
# the webhook refuses every event with 503. That is deliberate — a deployment
# that half-configured payments should fail loudly, not quietly accept
# unsigned events from anyone who finds the URL.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret Razorpay signs webhook bodies with. Set it in the Razorpay
# dashboard and paste the same value here; it is what separates a real capture
# from a stranger asking us to credit a folio.
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------- calls between services --
# One shared secret the platform uses to authenticate itself when no person is
# involved — the payment webhook confirming a booking, a scheduled night audit.
# Generate with: openssl rand -hex 32
# Unset, service authentication is off and every caller must be a real user.
SERVICE_TOKEN=

# Seals tenant payment credentials at rest (Fernet). Newest key first,
# comma-separated; every key listed can still decrypt, so rotating is: generate
# a new key, put it at the front, re-encrypt, then drop the old one.
# Generate with:
#   python -c "from chirala_common.secretbox import generate_key; print(generate_key())"
# Unset, saving a gateway secret is refused rather than stored in plaintext.
CREDENTIAL_ENCRYPTION_KEYS=

# --- Channel manager (Channex) -----------------------------------------
# Channex fronts Booking.com, Agoda, Expedia and the rest, so the PMS
# integrates once instead of per OTA. Staging is the default; point this at
# production only deliberately.
CHANNEX_API_URL=https://staging.channex.io/api/v1
# From staging.channex.io/user_profile. Unset, the integration is off.
CHANNEX_API_KEY=
# A value you invent, then paste into the Channex webhook's custom headers as
# X-Channex-Webhook-Secret. Channex does not sign payloads, so this header is
# the only thing standing between the endpoint and anyone who finds the URL.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CHANNEX_WEBHOOK_SECRET=

# --- Database roles (row-level security, schema §12) -------------------------
# In Docker the services connect as APP_DB_USER, a login that owns no tables and
# cannot bypass RLS. POSTGRES_USER owns the schema and is used only for
# migrations and grants (<SERVICE>_MIGRATION_DATABASE_URL). Use a strong,
# URL-safe password in any shared environment.
APP_DB_USER=pms_app
APP_DB_PASSWORD=change-me-url-safe
# IAM_MIGRATION_DATABASE_URL=postgresql+psycopg://pms:...@postgres:5432/chirala_pms
# BOOKING_MIGRATION_DATABASE_URL=postgresql+psycopg://pms:...@postgres:5432/chirala_pms
# FINANCE_MIGRATION_DATABASE_URL=postgresql+psycopg://pms:...@postgres:5432/chirala_pms
