  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Stayview", "url": "/reservations", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Housekeeping", "url": "/housekeeping", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Restaurant & POS", "url": "/pos", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
